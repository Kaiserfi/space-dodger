{
  "rules": {
    "scores": {
      ".read": true,
      ".indexOn": [
        "score"
      ]
    },
    "snake": {
      ".read": true,
      ".indexOn": [
        "score"
      ]
    },
    "crawler": {
      ".read": true,
      ".indexOn": [
        "score"
      ]
    },
    "adventure": {
      "saves": {
        ".read": true,
        "$id": {
          ".write": "auth != null && !root.child('banned').child(auth.uid).exists() && (auth != null && auth.uid === $id)",
          ".validate": "newData.hasChildren(['xp']) && newData.child('xp').hasChildren()"
        }
      },
      "claimed": {
        ".read": true,
        "$old": {
          ".write": "auth != null && !root.child('banned').child(auth.uid).exists() && (auth != null && !data.exists() && newData.val() === auth.uid)"
        }
      },
      "live": {
        ".read": true,
        "players": {
          "$id": {
            ".write": "auth != null && !root.child('banned').child(auth.uid).exists() && (auth != null && (auth.uid === $id || (!newData.exists() && data.child('t').val() < now - 60000)))",
            ".validate": "newData.hasChildren(['n', 'x', 'z']) && newData.child('n').isString() && newData.child('n').val().length <= 12 && newData.child('x').isNumber() && newData.child('z').isNumber()"
          }
        },
        "nodes": {
          "$key": {
            ".write": "auth != null && !root.child('banned').child(auth.uid).exists() && (auth != null && (!data.exists() || data.child('until').val() <= now))",
            ".validate": "newData.hasChildren(['until']) && newData.child('until').isNumber() && newData.child('until').val() <= now + 60000"
          }
        },
        "event": {
          ".write": "auth != null && !root.child('banned').child(auth.uid).exists() && (auth != null)"
        },
        "graves": {
          "$id": {
            ".write": "auth != null && !root.child('banned').child(auth.uid).exists() && (auth != null && auth.uid === $id)",
            ".validate": "newData.hasChildren(['x', 'z', 'items', 'until']) && newData.child('until').isNumber()"
          }
        },
        "mobs": {
          "$id": {
            ".write": "auth != null && !root.child('banned').child(auth.uid).exists() && (auth != null)"
          }
        },
        "ground": {
          "$key": {
            ".write": "auth != null && !root.child('banned').child(auth.uid).exists() && (auth != null && (data.exists() ? (data.child('by').val() === auth.uid || data.child('pub').val() <= now) : newData.child('by').val() === auth.uid))",
            ".validate": "newData.hasChildren(['n', 'q', 'by', 'pub', 'until']) && newData.child('q').isNumber() && newData.child('until').isNumber() && newData.child('until').val() <= now + 200000"
          }
        },
        "parties": {
          "$p": {
            ".write": "auth != null && !root.child('banned').child(auth.uid).exists() && (auth != null)"
          }
        },
        "fishstock": {
          "$fish": {
            ".write": "auth != null && !root.child('banned').child(auth.uid).exists() && (auth != null)",
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 200"
          }
        },
        "fires": {
          "$key": {
            ".write": "auth != null && !root.child('banned').child(auth.uid).exists() && (auth != null)",
            ".validate": "newData.hasChildren(['x', 'z', 'until']) && newData.child('x').isNumber() && newData.child('z').isNumber() && newData.child('until').isNumber() && newData.child('until').val() <= now + 100000"
          }
        }
      },
      "players": {
        ".read": true
      },
      "nodes": {
        ".read": true
      },
      "event": {
        ".read": true
      },
      "graves": {
        ".read": true
      },
      "mobs": {
        ".read": true
      }
    }
  }
}
